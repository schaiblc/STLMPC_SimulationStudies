<?xml version="1.0"?>
<!-- campaign.launch headless launch for the STLMPC revision simulation
     campaign (B1-B5). Loads params.yaml, then overrides the campaign knobs as
     node-private params (which take effect because they are set AFTER the
     rosparam load). No joystick / camera / rviz, so many runs can be batched
     by scripts/run_campaign.sh. Select the planner with the "planner" arg:
     navigation_STLMPC (static/dynamic, const v), navigation_STLMPC_vary_v
     (racing, variable v), or navigation_FGM (gap-following baseline). -->
<launch>
  <!-- Select the map by basename (map1..map5). The full path is derived from it and
       is also the key into config/map_starts.yaml for the ego/adversary start poses.
       Pass a full path via map:= only to use a map that is not in the start table. -->
  <arg name="map_name"       default="map1"/>
  <arg name="map"            default="$(find f1tenth_simulator)/maps/$(arg map_name).yaml"/>
  <arg name="planner"        default="navigation_STLMPC"/>

  <!-- logging -->
  <arg name="log_file"       default=""/>
  <arg name="enable_logging" default="1"/>

  <!-- B1: horizon segmentation -->
  <arg name="nMPC"           default="2"/>
  <arg name="kMPC"           default="8"/>

  <!-- B2: velocity-constraint ablation (vary_v only) -->
  <arg name="enable_gvsteer" default="1"/>
  <arg name="enable_gvobs"   default="1"/>
  <arg name="hard_clamp_v"   default="0"/>

  <!-- B4: MPPI baseline (vary_v only). Defaults match params.yaml; override to sweep.
       n_evals per control step = mppi_K * mppi_iters. -->
  <arg name="use_mppi"       default="0"/>
  <arg name="mppi_K"         default="256"/>
  <arg name="mppi_iters"     default="8"/>
  <arg name="mppi_lambda"    default="1.0"/>
  <arg name="mppi_sd_delta"  default="0.10"/>
  <arg name="mppi_sd_v"      default="0.30"/>

  <!-- B3: swept parameters (leave at nominal unless swept) -->
  <arg name="d_dot_factor_STLMPC_vary_v" default="30"/>
  <arg name="vel_factor_STLMPC_vary_v"   default="1"/>
  <arg name="safe_distance"  default="2"/>
  <arg name="vel_beta"       default="10"/>
  <arg name="stop_distance_decay" default="0.5"/>
  <arg name="theta_band_smooth"   default="200"/>

  <!-- B5: adversary + sensor degradation -->
  <arg name="adv_enable"     default="0"/>
  <arg name="adv_maneuver"   default="straight"/>
  <arg name="adv2_enable"    default="0"/>
  <arg name="scan_std_dev"   default="0.01"/>
  <arg name="beam_dropout_prob" default="0.0"/>

  <!-- Adversary placement: ego-relative by default (heading-invariant), with the
       geometry chosen per adv_maneuver (brake=lead, swerve/straight=crosser). Leave
       the offsets at -999 to use those per-maneuver defaults, or set them (m, m, rad
       in the ego frame: +forward, +left, heading offset) to retune. adv_relative:=0
       uses absolute adv_init_* map coordinates instead. -->
  <arg name="adv_relative"   default="1"/>
  <arg name="adv_forward"    default="-999.0"/>
  <arg name="adv_left"       default="-999.0"/>
  <arg name="adv_rel_theta"  default="-999.0"/>
  <arg name="adv2_forward"   default="-999.0"/>
  <arg name="adv2_left"      default="-999.0"/>
  <arg name="adv2_rel_theta" default="-999.0"/>

  <!-- Avoidance of the tracked adversary (TF-based; needs no camera). Defaults ON
       whenever an adversary is enabled, so dynamic runs actually plan around it. -->
  <arg name="use_neural_net" default="$(arg adv_enable)"/>

  <!-- Deterministic navigation start. auto_nav:=1 removes the hand-typed 'n' for
       batch runs. Either way the simulator anchors the adversary timeline to the
       nav-enable instant, so the ego always sees the full maneuver. -->
  <arg name="auto_nav"       default="0"/>
  <arg name="auto_nav_delay" default="3.0"/>

  <!-- Course completion + run termination. The run ends (success) when the ego
       reaches the per-map goal (config/map_starts.yaml) after leaving it by
       goal_arm_dist, or (failure) after run_timeout. shutdown_on_goal:=1 makes the
       simulator end the launch on either outcome (set for batch runs). -->
  <arg name="goal_arm_dist"    default="5.0"/>
  <arg name="run_timeout"      default="60.0"/>
  <arg name="shutdown_on_goal" default="0"/>

  <!-- Per-seed randomized start offset (paper: +/-0.3 m, +/-10 deg), added on top
       of the map_starts.yaml pose so that file stays the single source of truth. -->
  <arg name="ego_jitter_x"     default="0.0"/>
  <arg name="ego_jitter_y"     default="0.0"/>
  <arg name="ego_jitter_theta" default="0.0"/>

  <arg name="map_server_map" default="$(arg map)"/>
  <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_server_map)"/>
  <include file="$(find f1tenth_simulator)/launch/racecar_model.launch"/>

  <node pkg="f1tenth_simulator" name="f1tenth_simulator" type="simulator" output="screen"
        required="true">
    <rosparam command="load" file="$(find f1tenth_simulator)/params.yaml"/>
    <rosparam command="load" file="$(find f1tenth_simulator)/config/map_starts.yaml"/>
    <param name="map_name"          value="$(arg map_name)"/>
    <param name="move_base_wait"    value="0.1"/>
    <param name="adv_enable"        value="$(arg adv_enable)"/>
    <param name="adv_maneuver"      value="$(arg adv_maneuver)"/>
    <param name="adv2_enable"       value="$(arg adv2_enable)"/>
    <param name="adv_relative"      value="$(arg adv_relative)"/>
    <param name="adv_forward"       value="$(arg adv_forward)"/>
    <param name="adv_left"          value="$(arg adv_left)"/>
    <param name="adv_rel_theta"     value="$(arg adv_rel_theta)"/>
    <param name="adv2_forward"      value="$(arg adv2_forward)"/>
    <param name="adv2_left"         value="$(arg adv2_left)"/>
    <param name="adv2_rel_theta"    value="$(arg adv2_rel_theta)"/>
    <param name="scan_std_dev"      value="$(arg scan_std_dev)"/>
    <param name="beam_dropout_prob" value="$(arg beam_dropout_prob)"/>
    <param name="goal_arm_dist"     value="$(arg goal_arm_dist)"/>
    <param name="run_timeout"       value="$(arg run_timeout)"/>
    <param name="shutdown_on_goal"  value="$(arg shutdown_on_goal)"/>
    <param name="ego_jitter_x"      value="$(arg ego_jitter_x)"/>
    <param name="ego_jitter_y"      value="$(arg ego_jitter_y)"/>
    <param name="ego_jitter_theta"  value="$(arg ego_jitter_theta)"/>
  </node>

  <node pkg="f1tenth_simulator" name="mux_controller" type="mux" output="screen">
    <rosparam command="load" file="$(find f1tenth_simulator)/params.yaml"/>
  </node>
  <node pkg="f1tenth_simulator" name="behavior_controller" type="behavior_controller" output="screen">
    <rosparam command="load" file="$(find f1tenth_simulator)/params.yaml"/>
    <param name="auto_nav"          value="$(arg auto_nav)"/>
    <param name="auto_nav_delay"    value="$(arg auto_nav_delay)"/>
  </node>

  <node pkg="f1tenth_simulator" name="$(arg planner)" type="$(arg planner)" output="screen">
    <rosparam command="load" file="$(find f1tenth_simulator)/params.yaml"/>
    <param name="enable_logging"    value="$(arg enable_logging)"/>
    <param name="log_file"          value="$(arg log_file)"/>
    <param name="use_neural_net"    value="$(arg use_neural_net)"/>
    <param name="nMPC"              value="$(arg nMPC)"/>
    <param name="kMPC"              value="$(arg kMPC)"/>
    <param name="enable_gvsteer"    value="$(arg enable_gvsteer)"/>
    <param name="enable_gvobs"      value="$(arg enable_gvobs)"/>
    <param name="hard_clamp_v"      value="$(arg hard_clamp_v)"/>
    <param name="use_mppi"          value="$(arg use_mppi)"/>
    <param name="mppi_K"            value="$(arg mppi_K)"/>
    <param name="mppi_iters"        value="$(arg mppi_iters)"/>
    <param name="mppi_lambda"       value="$(arg mppi_lambda)"/>
    <param name="mppi_sd_delta"     value="$(arg mppi_sd_delta)"/>
    <param name="mppi_sd_v"         value="$(arg mppi_sd_v)"/>
    <param name="d_dot_factor_STLMPC_vary_v" value="$(arg d_dot_factor_STLMPC_vary_v)"/>
    <param name="vel_factor_STLMPC_vary_v"   value="$(arg vel_factor_STLMPC_vary_v)"/>
    <param name="safe_distance"     value="$(arg safe_distance)"/>
    <param name="vel_beta"          value="$(arg vel_beta)"/>
    <param name="stop_distance_decay" value="$(arg stop_distance_decay)"/>
    <param name="theta_band_smooth" value="$(arg theta_band_smooth)"/>
  </node>

  <!-- Optional visualization (gui:=true) for a single watchable run. Leave false
       for the batch campaign so runs stay lightweight and headless. -->
  <arg name="gui" default="false"/>
  <node if="$(arg gui)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find f1tenth_simulator)/launch/simulator.rviz"/>
</launch>
